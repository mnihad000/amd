LABEL_PROVIDER=gemini
LABEL_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

SOURCE_MODE=manifest
SOURCE_MANIFEST_PATH=backend/examples/source_manifest.json
WEB_SEARCH_PROVIDER_ORDER=duckduckgo,bing
BING_SEARCH_API_KEY=
YT_DLP_PATH=yt-dlp
WEB_IMAGE_SEARCH_RESULTS_PER_CLASS=10
WEB_IMAGE_DOWNLOADS_PER_CLASS=4
YOUTUBE_SEARCH_RESULTS_PER_CLASS=6
YOUTUBE_DOWNLOADS_PER_CLASS=2
DOWNLOAD_TIMEOUT_SECONDS=20
DOWNLOAD_RETRY_COUNT=2
DOWNLOAD_USER_AGENT=AutonomousDatasetAgent/0.1
SOURCE_DOMAIN_ALLOWLIST=
SOURCE_DOMAIN_DENYLIST=

WEB_IMAGE_TARGET_RATIO=0.7
VIDEO_TARGET_RATIO=0.3

FFMPEG_PATH=ffmpeg
FRAMES_PER_SECOND=0.5
MAX_FRAMES_PER_VIDEO=40

MIN_QUALITY_SCORE=0.6
MIN_LABEL_CONFIDENCE=0.7
MIN_SAMPLES_TO_LABEL=3
MIN_SAMPLES_FOR_TRAINING=5
MIN_IMAGE_WIDTH=160
MIN_IMAGE_HEIGHT=160
MIN_SHARPNESS_SCORE=5.0
MIN_CONTRAST_STD=8.0
MIN_BRIGHTNESS_MEAN=35.0
MAX_BRIGHTNESS_MEAN=220.0
MIN_ASPECT_RATIO=0.2
MAX_ASPECT_RATIO=5.0

MAX_RUNTIME_SECONDS=1800
MAX_DOWNLOADED_SOURCES=50
MAX_LABEL_CALLS=200
MAX_ACCEPTED_SAMPLES=150

ENABLE_TRAINING=false
YOLO_MODEL=yolov8n.pt
YOLO_EPOCHS=25
YOLO_IMAGE_SIZE=640
OUTPUT_ROOT=backend/artifacts
